+bool SystemTray::ptmCommitOrder(const QStringList &visibleOrder)
+{
+    auto *model = sortedSystemTrayModel();
+    QStringList current;
+    for (int row = 0; row < model->rowCount(); ++row) {
+        const auto idx = model->index(row, 0);
+        if (idx.data(static_cast<int>(BaseModel::BaseRole::EffectiveStatus)).toInt() == Plasma::Types::ActiveStatus) {
+            current.append(idx.data(static_cast<int>(BaseModel::BaseRole::ItemId)).toString());
+        }
+    }
+    auto expected = current;
+    auto received = visibleOrder;
+    expected.sort();
+    received.sort();
+    if (expected != received || visibleOrder.contains(QString()) || current == visibleOrder) {
+        return false;
+    }
+    QStringList saved = visibleOrder;
+    saved.removeDuplicates();
+    for (const auto &id : m_settings->ptmOrder()) {
+        if (!saved.contains(id)) {
+            saved.append(id);
+        }
+    }
+    m_settings->setPtmOrder(saved);
+    Q_EMIT configNeedsSaving();
+    return true;
+}
