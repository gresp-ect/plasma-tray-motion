diff --git a/applets/systemtray/ptmdroprouter.cpp b/applets/systemtray/ptmdroprouter.cpp
new file mode 100644
index 0000000..4de94e0
--- /dev/null
+++ b/applets/systemtray/ptmdroprouter.cpp
@@ -0,0 +1,164 @@
+// SPDX-FileCopyrightText: 2026 Plasma Tray Motion contributors
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "ptmdroprouter.h"
+#include <QDrag>
+#include <QGuiApplication>
+#include <QPainter>
+#include <QRasterWindow>
+#include <QtGui/private/qpaintdevicewindow_p.h>
+#include <QDebug>
+#include <QDragEnterEvent>
+#include <QDropEvent>
+#include <QMimeData>
+#include <QPixmap>
+#include <QQuickItem>
+#include <QQuickItemGrabResult>
+#include <QQuickWindow>
+
+static const char s_mime[] = "application/x-plasma-tray-motion";
+
+PtmDropRouter::PtmDropRouter(QObject *parent) : QObject(parent) {}
+PtmDropRouter::~PtmDropRouter() { end(m_token); }
+
+bool PtmDropRouter::begin(QQuickItem *grid, const QString &token)
+{
+    if (m_nativeExecuting) return false;
+    end(m_token);
+    if (!grid || !grid->window() || token.isEmpty()) return false;
+    m_grid = grid;
+    m_window = grid->window();
+    m_token = token;
+    m_window->installEventFilter(this);
+    return true;
+}
+
+void PtmDropRouter::end(const QString &token)
+{
+    if (token != m_token) return;
+    if (m_imageWindow) {
+        m_imageWindow->removeEventFilter(this);
+        // An invalidated transaction no longer hides the drag image; return the transparent buffer to Qt for normal repainting.
+        if (m_nativeInside) m_imageWindow->update();
+    }
+    m_imageWindow.clear();
+    m_nativeInside = false;
+    if (m_window) m_window->removeEventFilter(this);
+    m_window.clear();
+    m_grid.clear();
+    m_token.clear();
+}
+
+int PtmDropRouter::runNativeDrag(QObject *imageResult, const QString &token)
+{
+    if (m_nativeExecuting) return int(Qt::IgnoreAction);
+    auto *grab = qobject_cast<QQuickItemGrabResult *>(imageResult);
+    if (!m_window || m_token != token || !grab || grab->image().isNull()) {
+        qWarning() << "[PTM] Native drag image unavailable; refusing to start a drag without an image";
+        return int(Qt::IgnoreAction);
+    }
+    // Use the completed pixel image directly,
+    // bypassing the QML grab URL and Qt Quick asynchronous image loader.
+    const QPixmap pixmap = QPixmap::fromImage(grab->image());
+    if (pixmap.isNull()) return int(Qt::IgnoreAction);
+    auto *drag = new QDrag(m_window);
+    auto *mime = new QMimeData;
+    mime->setData(QLatin1String(s_mime), token.toUtf8());
+    drag->setMimeData(mime);
+    drag->setPixmap(pixmap);
+    drag->setHotSpot(QPoint(-24, -24));
+    m_nativeExecuting = true;
+    Q_EMIT nativeDragPrepared(drag);
+    qInfo() << "[PTM] Native image size" << pixmap.size() << "device pixel ratio" << pixmap.devicePixelRatio();
+    // The Qt Wayland backend manages the drag operation;
+    // use the source window as the QObject parent, following the QDrag lifetime convention.
+    const int result = int(drag->exec(Qt::MoveAction, Qt::MoveAction));
+    m_nativeExecuting = false;
+    if (m_imageWindow) m_imageWindow->removeEventFilter(this);
+    m_imageWindow.clear();
+    m_nativeInside = false;
+    return result;
+}
+
+// The public QDrag API does not support replacing the image during exec().
+// Keep the Wayland surface and clear only the raster buffer inside the tray; this uses a Qt 6.11 private API,
+// with release compatibility restricted by exact Qt RPM matching.
+// Do not hide or destroy the window, which would disrupt its compositor drag role.
+void PtmDropRouter::clearNativeImage()
+{
+    if (!m_imageWindow || !m_imageWindow->isExposed()) return;
+    auto *device = static_cast<QPaintDeviceWindowPrivate *>(QWindowPrivate::get(m_imageWindow));
+    const QRegion region(QRect(QPoint(), m_imageWindow->size()));
+    device->beginPaint(region);
+    {
+        QPainter painter(m_imageWindow);
+        painter.setCompositionMode(QPainter::CompositionMode_Source);
+        painter.fillRect(QRect(QPoint(), m_imageWindow->size()), Qt::transparent);
+    }
+    device->endPaint();
+    device->flush(region);
+}
+
+void PtmDropRouter::updateNativeImage(bool inside)
+{
+    const bool changed = m_nativeInside != inside;
+    m_nativeInside = inside;
+    if (!m_nativeExecuting) return;
+    if (m_imageWindow && !changed) return;
+    if (!m_imageWindow) {
+        for (auto *window : QGuiApplication::allWindows()) {
+            if (window->inherits("QShapedPixmapWindow")) {
+                m_imageWindow = qobject_cast<QRasterWindow *>(window);
+                if (m_imageWindow) m_imageWindow->installEventFilter(this);
+                break;
+            }
+        }
+    }
+    if (!m_imageWindow) return;
+    if (inside) clearNativeImage();
+    else m_imageWindow->update();
+}
+
+bool PtmDropRouter::eventFilter(QObject *watched, QEvent *event)
+{
+    if (watched == m_imageWindow && m_nativeExecuting && m_nativeInside
+        && (event->type() == QEvent::UpdateRequest || event->type() == QEvent::Paint)) {
+        clearNativeImage();
+        return true;
+    }
+    if (watched != m_window || !m_grid || m_token.isEmpty()) return false;
+    if (event->type() == QEvent::DragLeave) {
+        updateNativeImage(false);
+        Q_EMIT left(m_token);
+        return true;
+    }
+    if (event->type() != QEvent::DragEnter && event->type() != QEvent::DragMove && event->type() != QEvent::Drop) return false;
+    auto *drop = static_cast<QDropEvent *>(event);
+    if (!drop->mimeData()) return false;
+    if (QString::fromUtf8(drop->mimeData()->data(QLatin1String(s_mime))) != m_token) return false;
+    const QString token = m_token;
+    const QPointF point = m_grid->mapFromScene(drop->position());
+    const bool inside = m_grid->isVisible() && m_grid->isEnabled()
+        && QRectF(QPointF(), m_grid->size()).contains(point);
+    updateNativeImage(inside);
+    if (!inside) {
+        Q_EMIT left(token);
+        // Keep enter routing across the source panel so a drag can enter another component before returning to the tray.
+        // Releasing outside the tray never commits an order.
+        if (event->type() == QEvent::DragEnter) {
+            drop->setDropAction(Qt::MoveAction);
+            drop->accept();
+        } else {
+            drop->ignore();
+        }
+        return true;
+    }
+    if (event->type() == QEvent::Drop) Q_EMIT dropped(token, point);
+    else Q_EMIT moved(token, point);
+    // A synchronous drop handler may invalidate the current gesture.
+    if (m_token != token || !m_grid) drop->ignore();
+    else {
+        drop->setDropAction(Qt::MoveAction);
+        drop->accept();
+    }
+    return true;
+}
