+++ b/applets/systemtray/ptmdroprouter.h
@@ -0,0 +1,40 @@
+// SPDX-FileCopyrightText: 2026 Plasma Tray Motion contributors
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include <QObject>
+#include <QPointer>
+#include <QPointF>
+#include <QString>
+class QQuickItem;
+class QQuickWindow;
+class QRasterWindow;
+
+// Active only during one native gesture in the source panel window,
+// routing this tray private MIME drag events before other panel components intercept them.
+class PtmDropRouter : public QObject
+{
+    Q_OBJECT
+public:
+    explicit PtmDropRouter(QObject *parent = nullptr);
+    ~PtmDropRouter() override;
+    bool begin(QQuickItem *grid, const QString &token);
+    void end(const QString &token);
+    Q_INVOKABLE int runNativeDrag(QObject *imageResult, const QString &token);
+Q_SIGNALS:
+    void nativeDragPrepared(QObject *drag);
+    void moved(const QString &token, const QPointF &point);
+    void left(const QString &token);
+    void dropped(const QString &token, const QPointF &point);
+protected:
+    bool eventFilter(QObject *watched, QEvent *event) override;
+private:
+    friend struct PtmDropRouterImageCheck;
+    void updateNativeImage(bool inside);
+    void clearNativeImage();
+    QPointer<QRasterWindow> m_imageWindow;
+    bool m_nativeExecuting = false;
+    bool m_nativeInside = false;
+    QPointer<QQuickWindow> m_window;
+    QPointer<QQuickItem> m_grid;
+    QString m_token;
+};
