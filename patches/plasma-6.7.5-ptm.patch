diff --git a/applets/systemtray/qml/PtmController.qml b/applets/systemtray/qml/PtmController.qml
new file mode 100644
index 0000000..99db16a
--- /dev/null
+++ b/applets/systemtray/qml/PtmController.qml
@@ -0,0 +1,289 @@
+// SPDX-FileCopyrightText: 2026 Plasma Tray Motion contributors
+// SPDX-License-Identifier: LGPL-2.0-or-later
+// Plasma Tray Motion: independently implemented on KDE Plasma 6.7.5.
+pragma ComponentBehavior: Bound
+import QtQuick
+import QtQuick.Window
+import org.kde.kirigami as Kirigami
+import org.kde.plasma.plasmoid
+
+Item {
+    id: motion
+    required property GridView grid
+    required property var model
+    required property int iconSize
+    anchors.fill: parent
+    z: 20000
+
+    property var sourceItem: null
+    property int dragIndex: -1
+    property int destination: -1
+    property var slots: []
+    property var ids: []
+    property point pressPosition
+    property point pointerPosition
+    property point delta: Qt.point(0, 0)
+    property bool inside: false
+    property bool nativeRunning: false
+    property bool nativeInvalidated: false
+    property bool dropAccepted: false
+    property var pendingDropOrder: []
+    property var capture: null
+    property int captureSerial: 0
+    property string token: ""
+
+    function completeNative(action) {
+        console.info("[PTM] Native drag finished", action, "accepted", motion.dropAccepted, "invalidated", motion.nativeInvalidated);
+        const commit = action === Qt.MoveAction && !motion.nativeInvalidated
+            && motion.dropAccepted && motion.pendingDropOrder.length > 0;
+        const order = motion.pendingDropOrder.slice();
+        motion.reset();
+        if (commit) console.info("[PTM] Native order commit", Plasmoid.ptmCommitOrder(order));
+    }
+    readonly property int animationMs: Kirigami.Units.longDuration <= 0 ? 0
+        : Math.round(Math.max(0, Math.min(500, Plasmoid.configuration.ptmAnimationMs)) * Kirigami.Units.longDuration / 200)
+    signal holdStarted(var item)
+    signal interactionCanceled(var item)
+
+    function arm(item, x, y) {
+        // Do not let a new gesture overwrite the current transaction before the native event loop exits.
+        if (nativeRunning) return;
+        cancel();
+        if (grid.count < 2) return;
+        sourceItem = item;
+        pressPosition = item.mapToItem(grid, x, y);
+        pointerPosition = pressPosition;
+        token = Date.now().toString(36) + "-" + Math.random().toString(36).slice(2);
+        const serial = captureSerial;
+        // Capture while waiting for the hold so a deferred image callback does not
+        // start QDrag outside the current mouse event.
+        item.iconContainer.grabToImage(result => {
+            if (serial === motion.captureSerial && motion.sourceItem === item) motion.capture = result;
+        });
+        hold.restart();
+    }
+    function disarm() { hold.stop(); }
+    function cancel(reason = "Canceled") {
+        if (dragIndex >= 0) console.info("[PTM] Drag canceled", reason);
+        if (nativeRunning) {
+            // Wayland manages the drag image until release or Esc; even if the compositor retains it,
+            // invalidate this ordering transaction immediately.
+            nativeInvalidated = true;
+            Plasmoid.ptmUnwatchNativeDrop(token);
+        }
+        reset(nativeRunning);
+    }
+    function reset(keepNative = false) {
+        ++captureSerial;
+        // Cancellation and completion share cleanup; cancellation retains the native lifecycle until it exits.
+        if (!keepNative) {
+            nativeRunning = false;
+            nativeInvalidated = false;
+        }
+        dropAccepted = false;
+        pendingDropOrder = [];
+        capture = null;
+        if (sourceItem) interactionCanceled(sourceItem);
+        hold.stop();
+        dragIndex = -1;
+        destination = -1;
+        sourceItem = null;
+        slots = [];
+        ids = [];
+        delta = Qt.point(0, 0);
+        inside = false;
+    }
+    function begin() {
+        if (!sourceItem || !Plasmoid.configuration.ptmEnabled) return;
+        const positions = [];
+        const names = [];
+        for (let i = 0; i < grid.count; ++i) {
+            const delegate = grid.itemAtIndex(i) as ItemLoader;
+            if (!delegate || !delegate.item || !delegate.model.itemId) { cancel(); return; }
+            const p = delegate.mapToItem(grid, 0, 0);
+            positions.push(Qt.point(p.x, p.y));
+            names.push(delegate.model.itemId);
+        }
+        // Indistinguishable instances with the same ID retain KDE source order;
+        // do not offer per-instance ordering that cannot be persisted reliably.
+        const id = sourceItem.model.itemId;
+        if (names.filter(value => value === id).length !== 1) { cancel(); return; }
+        slots = positions;
+        ids = names;
+        destination = sourceItem.index;
+        dragIndex = sourceItem.index;
+        inside = true;
+        console.info("[PTM] Hold started", dragIndex, "icon count", ids.length);
+        holdStarted(sourceItem);
+        forceActiveFocus(Qt.MouseFocusReason);
+        move(pointerPosition);
+    }
+    function startNative() {
+        if (nativeRunning || dragIndex < 0 || !capture) return;
+        console.info("[PTM] Left tray; starting native drag");
+        if (!Plasmoid.ptmWatchNativeDrop(grid, token)) {
+            console.warn("[PTM] Cannot watch source panel drag events");
+            return;
+        }
+        const nativeToken = token;
+        nativeRunning = true;
+        nativeInvalidated = false;
+        dropAccepted = false;
+        // Call directly from MouseArea.onPositionChanged,
+        // while the left mouse button Wayland serial and implicit grab are still available.
+        try {
+            completeNative(Plasmoid.ptmRunNativeDrag(capture, nativeToken));
+        } finally {
+            Plasmoid.ptmUnwatchNativeDrop(nativeToken);
+            if (motion.nativeRunning) motion.reset();
+        }
+    }
+    function prepareDrop(point) {
+        move(point);
+        if (!nativeRunning || nativeInvalidated || !inside || dragIndex < 0) return false;
+        const order = ids.slice();
+        order.splice(destination, 0, order.splice(dragIndex, 1)[0]);
+        pendingDropOrder = order;
+        dropAccepted = true;
+        return true;
+    }
+    function accepts(event) {
+        return nativeRunning && !nativeInvalidated && dragIndex >= 0
+            && event.getDataAsString("application/x-plasma-tray-motion") === token;
+    }
+    function move(point) {
+        pointerPosition = point;
+        if (dragIndex < 0) return;
+        inside = point.x >= 0 && point.y >= 0 && point.x < grid.width && point.y < grid.height;
+        delta = Qt.point(point.x - pressPosition.x, point.y - pressPosition.y);
+        if (!inside) { destination = dragIndex; return; }
+        let nearest = dragIndex;
+        let distance = Infinity;
+        for (let i = 0; i < slots.length; ++i) {
+            const dx = point.x - slots[i].x - grid.cellWidth / 2;
+            const dy = point.y - slots[i].y - grid.cellHeight / 2;
+            const d = dx * dx + dy * dy;
+            if (d < distance) { distance = d; nearest = i; }
+        }
+        if (destination !== nearest) console.info("[PTM] Order preview", dragIndex, "->", nearest);
+        destination = nearest;
+    }
+    function offsetFor(index) {
+        if (dragIndex < 0 || slots.length !== grid.count) return Qt.point(0, 0);
+        if (index === dragIndex) return nativeRunning && !inside ? Qt.point(0, 0) : delta;
+        let slot = index;
+        if (dragIndex < destination && index > dragIndex && index <= destination) --slot;
+        if (dragIndex > destination && index >= destination && index < dragIndex) ++slot;
+        return Qt.point(slots[slot].x - slots[index].x, slots[slot].y - slots[index].y);
+    }
+    function finish(point) {
+        if (nativeRunning) return;
+        hold.stop();
+        move(point);
+        const from = dragIndex;
+        const to = destination;
+        const commit = from >= 0 && inside && from !== to;
+        const order = ids.slice();
+        if (commit) order.splice(to, 0, order.splice(from, 1)[0]);
+        // Clear the preview before changing the model so model signals cannot cancel the drag being committed.
+        reset();
+        if (commit) console.info("[PTM] Local order commit", Plasmoid.ptmCommitOrder(order));
+    }
+
+    function snapshotMatches() {
+        if (dragIndex < 0) return true;
+        if (grid.count !== ids.length) return false;
+        for (let i = 0; i < ids.length; ++i) {
+            const delegate = grid.itemAtIndex(i) as ItemLoader;
+            if (!delegate || delegate.model.itemId !== ids[i]) return false;
+        }
+        return true;
+    }
+    function checkSnapshot() {
+        if (!snapshotMatches()) cancel("Icon identity or order changed");
+    }
+
+    Timer {
+        id: hold
+        objectName: "ptmHoldTimer"
+        interval: Math.max(100, Math.min(1500, Plasmoid.configuration.ptmHoldMs))
+        onTriggered: motion.begin()
+    }
+    // Only this tray instance accepts its own native drag;
+    // other windows display the compositor image without exported URLs or application actions.
+    DropArea {
+        anchors.fill: parent
+        keys: ["application/x-plasma-tray-motion"]
+        onEntered: event => {
+            event.accepted = motion.accepts(event);
+            console.info("[PTM] Native drag entered tray", event.accepted);
+            if (event.accepted) motion.move(Qt.point(event.x, event.y));
+        }
+        onPositionChanged: event => {
+            event.accepted = motion.accepts(event);
+            if (event.accepted) motion.move(Qt.point(event.x, event.y));
+        }
+        onExited: motion.move(Qt.point(-1, -1))
+        onDropped: event => {
+            console.info("[PTM] Native drop", motion.accepts(event));
+            if (!motion.accepts(event)) { event.accepted = false; return; }
+            if (motion.prepareDrop(Qt.point(event.x, event.y))) event.accept(Qt.MoveAction);
+        }
+    }
+    Connections {
+        target: Plasmoid
+        function onPtmNativeDragMoved(nativeToken, point) {
+            if (motion.nativeRunning && !motion.nativeInvalidated && motion.token === nativeToken) motion.move(point);
+        }
+        function onPtmNativeDragLeft(nativeToken) {
+            if (motion.nativeRunning && motion.token === nativeToken) motion.move(Qt.point(-1, -1));
+        }
+        function onPtmNativeDragDropped(nativeToken, point) {
+            if (motion.nativeRunning && !motion.nativeInvalidated && motion.token === nativeToken) {
+                console.info("[PTM] Panel forwarded drop", motion.prepareDrop(point));
+            }
+        }
+    }
+    Keys.onEscapePressed: event => { cancel(); event.accepted = true; }
+    Shortcut {
+        sequence: "Escape"
+        enabled: motion.dragIndex >= 0 && !motion.nativeRunning
+        context: Qt.ApplicationShortcut
+        onActivated: motion.cancel()
+    }
+    Connections {
+        target: motion.model
+        function onRowsAboutToBeInserted() { motion.cancel(); }
+        function onRowsAboutToBeRemoved() { motion.cancel(); }
+        function onRowsAboutToBeMoved() { motion.cancel(); }
+        function onModelAboutToBeReset() { motion.cancel(); }
+        function onLayoutChanged() {
+            Qt.callLater(motion.checkSnapshot);
+        }
+        function onDataChanged() {
+            // Tooltip, name, and attention animation updates do not change icon membership;
+            // wait for delegate roles to synchronize with the model before checking.
+            Qt.callLater(motion.checkSnapshot);
+        }
+    }
+    Connections {
+        target: motion.Window.window
+        function onVisibleChanged() {
+            if (!motion.Window.window.visible) motion.cancel();
+        }
+    }
+    Connections {
+        target: Plasmoid.configuration
+        function onPtmEnabledChanged() { motion.cancel(); }
+        function onReverseIconOrderChanged() { motion.cancel(); }
+        function onScaleIconsToFitChanged() { motion.cancel(); }
+        function onIconSpacingChanged() { motion.cancel(); }
+    }
+    Connections {
+        target: motion.grid
+        function onWidthChanged() { motion.cancel(); }
+        function onHeightChanged() { motion.cancel(); }
+        function onCellWidthChanged() { motion.cancel(); }
+        function onCellHeightChanged() { motion.cancel(); }
+    }
+}
